<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/subject_details_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/app_bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="36dp">

            <!-- 56dp header: Back - Subject Details - WSPA PUW -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <FrameLayout
                    android:id="@+id/button_back_container"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true">

                    <ImageButton
                        android:id="@+id/button_back"
                        style="@style/WSPlanner.HeaderIconButton"
                        android:layout_gravity="center"
                        android:contentDescription="@string/button_back"
                        android:src="@drawable/ic_arrow_back" />
                </FrameLayout>

                <TextView
                    android:id="@+id/toolbar_title"
                    style="@style/WSPlanner.TopBarTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_marginHorizontal="56dp"
                    android:text="@string/subject_details_title" />

                <FrameLayout
                    android:id="@+id/button_open_course"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:clickable="true"
                    android:clipChildren="false"
                    android:contentDescription="@string/subject_open_puw_course"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_icon_btn"
                        android:duplicateParentState="true">

                        <ImageView
                            android:id="@+id/content_open_course"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_wspa_logo" />

                        <ProgressBar
                            android:id="@+id/progress_open_course"
                            style="?android:attr/progressBarStyleSmall"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:indeterminate="true"
                            android:indeterminateTint="?attr/colorPrimary"
                            android:visibility="gone" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="1dp"
                        android:layout_marginBottom="1dp"
                        android:background="@drawable/bg_external_link_badge">

                        <ImageView
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_arrow_outward"
                            app:tint="?attr/text_secondary" />
                    </FrameLayout>
                </FrameLayout>
            </RelativeLayout>

            <!-- Content container with strict 16dp horizontal margins -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp">

                <!-- Hero Card: Subject info -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/WSPlanner.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/hero_subject_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/common_loading"
                            android:textColor="?attr/app_text"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <!-- Badges row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/hero_badge_location"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_wspa"
                                android:letterSpacing="0.03"
                                android:paddingStart="10dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="3dp"
                                android:textAllCaps="true"
                                android:textColor="?attr/badge_wspa_text"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/hero_badge_type"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_badge_type"
                                android:letterSpacing="0.03"
                                android:paddingStart="10dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="3dp"
                                android:textAllCaps="true"
                                android:textColor="?attr/badge_type_text"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="12dp"
                            android:background="?attr/divider_color" />

                        <!-- Teacher + email -->
                        <LinearLayout
                            android:id="@+id/hero_teacher_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_teacher"
                                    app:tint="?attr/text_muted" />

                                <TextView
                                    android:id="@+id/hero_teacher_name"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:ellipsize="end"
                                    android:fontFamily="sans-serif-medium"
                                    android:maxLines="1"
                                    android:text=""
                                    android:textColor="?attr/app_text"
                                    android:textSize="14sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/hero_teacher_email_row"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="24dp"
                                android:layout_marginTop="2dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:visibility="gone">

                                <ImageView
                                    android:id="@+id/hero_teacher_email_icon"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:layout_marginEnd="6dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_mail"
                                    app:tint="?attr/text_muted" />

                                <TextView
                                    android:id="@+id/hero_teacher_email"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:paddingVertical="2dp"
                                    android:text="@string/teacher_email_searching"
                                    android:textColor="?attr/text_muted"
                                    android:textSize="13sp" />

                                <ProgressBar
                                    android:id="@+id/teacher_email_progress"
                                    style="?android:attr/progressBarStyleSmall"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:layout_marginEnd="6dp"
                                    android:indeterminateTint="?attr/colorPrimary"
                                    android:visibility="gone" />

                                <ImageButton
                                    android:id="@+id/button_copy_teacher_email"
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="@string/teacher_email_copy_desc"
                                    android:padding="5dp"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/ic_content_copy"
                                    android:visibility="gone"
                                    app:tint="?attr/text_muted" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Room / Location row -->
                        <LinearLayout
                            android:id="@+id/hero_location_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:minHeight="24dp"
                            android:orientation="horizontal"
                            android:paddingVertical="2dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_location_pin"
                                app:tint="?attr/text_muted" />

                            <TextView
                                android:id="@+id/hero_room_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text=""
                                android:textColor="?attr/text_secondary"
                                android:textSize="13sp" />

                            <ImageView
                                android:id="@+id/hero_location_arrow_icon"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginStart="4dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_arrow_outward"
                                android:visibility="gone"
                                app:tint="?attr/text_muted" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Notes card with auto-save -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/WSPlanner.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_edit_note"
                                    app:tint="?attr/text_muted" />

                                <TextView
                                    style="@style/WSPlanner.SectionHeader"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="@string/subject_my_notes" />
                            </LinearLayout>

                            <!-- Live auto-save status -->
                            <LinearLayout
                                android:id="@+id/layout_saved_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/icon_notes_status"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_check"
                                    app:tint="?attr/input_border_ok" />

                                <TextView
                                    android:id="@+id/text_notes_status"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="@string/subject_notes_saved"
                                    android:textColor="?attr/input_border_ok"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </RelativeLayout>

                        <EditText
                            android:id="@+id/edit_subject_notes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_recessed_input"
                            android:gravity="top|start"
                            android:hint="@string/subject_notes_placeholder"
                            android:importantForAutofill="no"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="3"
                            android:padding="12dp"
                            android:textColor="?attr/app_text"
                            android:textColorHint="?attr/input_hint"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/subject_notes_local_hint"
                            android:textColor="?attr/text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Timeline header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp">

                    <TextView
                        style="@style/WSPlanner.SectionHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="@string/subject_timeline_title" />

                    <TextView
                        android:id="@+id/timeline_progress_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_badge_type"
                        android:letterSpacing="0.03"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:textColor="?attr/badge_type_text"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_timeline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
