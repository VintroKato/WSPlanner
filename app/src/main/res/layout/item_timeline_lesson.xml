<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <!-- Timeline column: dot + top and bottom lines -->
    <RelativeLayout
        android:id="@+id/timeline_column"
        android:layout_width="22dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="12dp">

        <View
            android:id="@+id/timeline_line_top"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_above="@id/timeline_dot_container"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:background="?attr/divider_color" />

        <FrameLayout
            android:id="@+id/timeline_dot_container"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true">

            <!-- Completed dot -->
            <FrameLayout
                android:id="@+id/dot_completed"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_timeline_dot_completed">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check"
                    app:tint="?attr/button_text" />
            </FrameLayout>

            <!-- Upcoming dot -->
            <TextView
                android:id="@+id/dot_upcoming_number"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_timeline_dot_upcoming"
                android:gravity="center"
                android:text="4"
                android:textColor="?attr/text_muted"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Current / Nearest dot -->
            <TextView
                android:id="@+id/dot_current_number"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_timeline_dot_current"
                android:gravity="center"
                android:text="3"
                android:textColor="?attr/button_text"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <View
            android:id="@+id/timeline_line_bottom"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_below="@id/timeline_dot_container"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:background="?attr/divider_color" />
    </RelativeLayout>

    <!-- Content column -->
    <LinearLayout
        android:id="@+id/timeline_content_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <!-- Standard meeting row -->
        <LinearLayout
            android:id="@+id/standard_content_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:minHeight="22dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/timeline_date_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="1. Środa, 02.10"
                    android:textColor="?attr/app_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/badge_special_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_badge_field"
                    android:letterSpacing="0.03"
                    android:paddingStart="6dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="1dp"
                    android:text="W TERENIE"
                    android:textColor="?attr/badge_field_text"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/timeline_status_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zrealizowane"
                    android:textColor="?attr/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/timeline_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="08:15 – 09:45 · Sala 204"
                android:textColor="?attr/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Highlighted card for nearest / current meeting -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/nearest_card_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/card_bg"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/active_lesson_border"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/nearest_date_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="3. Środa, 30.10"
                        android:textColor="?attr/app_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_badge_next"
                        android:letterSpacing="0.03"
                        android:paddingStart="8dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="2dp"
                        android:text="@string/subject_status_next"
                        android:textColor="?attr/badge_next_text"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/nearest_time_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="08:15 – 09:45"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/nearest_room_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Sala 204"
                    android:textColor="?attr/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</LinearLayout>
