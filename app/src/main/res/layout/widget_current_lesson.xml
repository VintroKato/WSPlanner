<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_dark"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="10dp">

    <!-- Top Bar: Status Chip (Left) + Time (Right) without overlapping -->
    <LinearLayout
        android:id="@+id/widget_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Status Chip (e.g. NOW / NEXT) clickable to toggle -->
        <LinearLayout
            android:id="@+id/widget_status_chip"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:background="@drawable/bg_badge_pill"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <TextView
                android:id="@+id/widget_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/schedule_badge_now"
                android:textColor="@color/badge_now_text"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Flexible Spacer to push time to the right without collision -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Lesson Time (Right) -->
        <TextView
            android:id="@+id/widget_lesson_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:ellipsize="none"
            android:maxLines="1"
            android:textColor="@color/widget_text_dark_primary"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Subtle Divider -->
    <LinearLayout
        android:id="@+id/widget_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="#25FFFFFF"
        android:orientation="horizontal" />

    <!-- Main Lesson Content -->
    <LinearLayout
        android:id="@+id/widget_lesson_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Subject Name (Allows 2 lines to ensure location fits without clipping) -->
        <TextView
            android:id="@+id/widget_lesson_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/widget_text_dark_primary"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <!-- Location Row (Room or Address) -->
        <LinearLayout
            android:id="@+id/widget_location_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_location_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:contentDescription="@string/widget_open_maps_tooltip"
                android:src="@drawable/ic_location_pin" />

            <TextView
                android:id="@+id/widget_lesson_location"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text_dark_secondary"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Empty State View (When no classes today, setup needed, or all classes finished) -->
    <LinearLayout
        android:id="@+id/widget_empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_no_classes_today"
            android:textColor="@color/widget_text_dark_primary"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_empty_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/widget_text_dark_secondary"
            android:textSize="10.5sp" />
    </LinearLayout>

</LinearLayout>
