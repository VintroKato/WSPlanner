<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:paddingBottom="80dp">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/button_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/app_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/title_label"
            style="@style/label"
            android:layout_marginTop="20dp"
            android:text="@string/onboarding_specialty_title"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/loading_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="48dp"
            android:paddingHorizontal="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title_label">

            <ProgressBar
                android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="?attr/app_text"
                android:indeterminateTintMode="src_atop"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/loading_label"
                style="@style/label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/onboarding_loading_specialties"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/content_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:animateLayoutChanges="true"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/title_label"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/subtitle_label"
                style="@style/label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:text="@string/onboarding_specialty_subtitle"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/specialties_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:paddingHorizontal="8dp" />

            <TextView
                android:id="@+id/no_specialties_label"
                style="@style/label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:text="@string/onboarding_no_specialties"
                android:visibility="gone" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/manual_specialty_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                android:text="@string/onboarding_manual_specialty_switch"
                android:textSize="16sp"
                android:textColor="?attr/app_text" />

            <EditText
                android:id="@+id/manual_specialty_input"
                style="@style/input"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:ems="8"
                android:paddingHorizontal="8dp"
                android:hint="@string/onboarding_manual_specialty_hint"
                android:inputType="textCapWords"
                android:textAlignment="textStart"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirm_button"
                style="@style/button"
                android:layout_width="183dp"
                android:layout_height="57dp"
                android:layout_marginTop="28dp"
                android:layout_gravity="center_horizontal"
                android:text="@string/onboarding_button_next" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/skip_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="183dp"
                android:layout_height="57dp"
                android:layout_marginTop="20dp"
                android:layout_gravity="center_horizontal"
                android:text="@string/onboarding_button_skip"
                android:textColor="?attr/app_text"
                android:textSize="20sp"
                app:cornerRadius="28dp"
                app:strokeColor="?attr/card_checked_border"
                app:strokeWidth="2dp"
                android:backgroundTint="@android:color/transparent" />

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
