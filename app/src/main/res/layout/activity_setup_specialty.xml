<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/app_bg"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/root_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="16dp">

            <ImageButton
                android:id="@+id/back_button"
                style="@style/WSPlanner.HeaderIconButton"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/button_back"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:id="@+id/title_label"
                style="@style/WSPlanner.TopBarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_marginHorizontal="52dp"
                android:text="@string/onboarding_specialty_title" />
        </RelativeLayout>

        <!-- 4-step progress indicator -->
        <include layout="@layout/layout_onboarding_steps" />

        <!-- Loading state -->
        <LinearLayout
            android:id="@+id/loading_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <ProgressBar
                android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:indeterminate="true"
                android:indeterminateTint="?attr/colorPrimary"
                android:indeterminateTintMode="src_atop" />

            <TextView
                android:id="@+id/loading_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/onboarding_loading_specialties"
                android:textColor="?attr/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Content -->
        <LinearLayout
            android:id="@+id/content_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/subtitle_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:text="@string/onboarding_specialty_subtitle"
                android:textColor="?attr/text_secondary"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/specialties_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:paddingHorizontal="16dp" />

            <!-- Recessed low-contrast info notice when no specialties are detected -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/no_specialties_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/surface_recessed"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_info"
                        app:tint="?attr/text_muted" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/no_specialties_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/onboarding_no_specialties"
                            android:textColor="?attr/text_secondary"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/no_specialties_desc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/onboarding_no_specialties_desc"
                            android:textColor="?attr/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Manual specialty card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/WSPlanner.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/manual_specialty_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/onboarding_manual_specialty_switch"
                        android:textColor="?attr/app_text"
                        android:textSize="15sp" />

                    <EditText
                        android:id="@+id/manual_specialty_input"
                        style="@style/WSPlanner.CardInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="@string/onboarding_manual_specialty_hint"
                        android:inputType="textCapWords"
                        android:tag="card_input"
                        android:textAlignment="textStart"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Wide primary CTA button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirm_button"
                style="@style/WSPlanner.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                android:text="@string/onboarding_button_next" />

            <!-- Calm secondary Skip button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/skip_button"
                style="@style/WSPlanner.SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                android:text="@string/onboarding_button_skip"
                android:textColor="?attr/text_secondary"
                android:textSize="15sp" />

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
