<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    tools:context=".ui.activities.WidgetConfigureActivity">

    <!-- Top App Bar -->
    <RelativeLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/button_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/button_back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/title_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/widget_settings_title"
            android:textColor="?attr/app_text"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:id="@+id/configure_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:animateLayoutChanges="true"
        app:layout_constraintBottom_toTopOf="@+id/button_save"
        app:layout_constraintTop_toBottomOf="@+id/top_bar">

        <LinearLayout
            android:id="@+id/configure_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Widget Type Selector Tabs -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/widget_type_toggle_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:checkedButton="@+id/tab_small_widget"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tab_small_widget"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/widget_tab_small"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tab_daily_widget"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/widget_tab_daily"
                    android:textSize="13sp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Live Preview Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_preview_title"
                android:textColor="?attr/app_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- SMALL WIDGET PREVIEW -->
            <LinearLayout
                android:id="@+id/container_small_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:gravity="center_horizontal"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/preview_container"
                    android:layout_width="220dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:animateLayoutChanges="true"
                    android:background="@drawable/bg_widget_dark"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="7dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Top Status Bar: Status Chip (Left) + Time (Right) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_pill"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="2dp"
                                android:text="@string/schedule_badge_now"
                                android:textColor="@color/badge_now_text"
                                android:textSize="9.5sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/preview_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="08:30 – 10:00"
                                android:textColor="@color/widget_text_dark_primary"
                                android:textSize="10.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Subtle Divider -->
                        <View
                            android:id="@+id/preview_divider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="4dp"
                            android:background="#25FFFFFF" />

                        <!-- Middle Content: Subject with Type prefix -->
                        <TextView
                            android:id="@+id/preview_subject"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="Wykład · Programowanie aplikacji mobilnych"
                            android:textColor="@color/widget_text_dark_primary"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <!-- Location Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:contentDescription="@string/widget_open_maps_tooltip"
                                android:src="@drawable/ic_location_pin" />

                            <TextView
                                android:id="@+id/preview_details"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Sala 214 (WSPA)"
                                android:textColor="@color/widget_text_dark_secondary"
                                android:textSize="10.5sp" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- DAILY SCHEDULE WIDGET PREVIEW -->
            <LinearLayout
                android:id="@+id/container_daily_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/preview_daily_root"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:animateLayoutChanges="true"
                    android:background="@drawable/bg_widget_dark"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Header -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:layout_toStartOf="@+id/preview_daily_actions"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/preview_daily_title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Чт, 08.10"
                                    android:textColor="@color/widget_text_dark_primary"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/preview_daily_subtitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="4 пары на сегодня"
                                    android:textColor="@color/widget_text_dark_secondary"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/preview_daily_actions"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/preview_btn_excel"
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:layout_marginEnd="4dp"
                                    android:background="@drawable/bg_widget_icon_btn"
                                    android:contentDescription="@string/widget_action_open_excel"
                                    android:padding="5dp"
                                    android:src="@drawable/ic_file_excel" />

                                <ImageView
                                    android:id="@+id/preview_btn_refresh"
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:layout_marginEnd="4dp"
                                    android:background="@drawable/bg_widget_icon_btn"
                                    android:contentDescription="@string/widget_action_refresh"
                                    android:padding="5dp"
                                    android:src="@drawable/ic_refresh" />

                                <ImageView
                                    android:id="@+id/preview_btn_app"
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:background="@drawable/bg_widget_icon_btn"
                                    android:contentDescription="@string/widget_action_open_app"
                                    android:padding="5dp"
                                    android:src="@drawable/ic_arrow_outward" />
                            </LinearLayout>
                        </RelativeLayout>

                        <!-- Sample Card 1 -->
                        <LinearLayout
                            android:id="@+id/preview_daily_card_1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_widget_item_dark"
                            android:orientation="vertical"
                            android:paddingHorizontal="9dp"
                            android:paddingVertical="6dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/preview_card_1_time"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="17:00 – 19:30"
                                    android:textColor="@color/widget_text_dark_primary"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="1dp"
                                    android:layout_weight="1" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_badge_rect"
                                    android:paddingHorizontal="5dp"
                                    android:paddingVertical="1dp"
                                    android:text="SEMINARIUM"
                                    android:textColor="@color/badge_now_text"
                                    android:textSize="9.5sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/preview_card_1_subject"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:text="Seminarium i przygotowanie pracy dyplomowej cz.2"
                                android:textColor="@color/widget_text_dark_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/preview_card_1_room"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Online, PUW"
                                android:textColor="@color/badge_field_text"
                                android:textSize="10.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- Theme / Background Selection (Applies to widgets) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/widget_theme_title"
                android:textColor="?attr/app_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/theme_radio_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/radio_theme_dark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_theme_dark"
                    android:textColor="?attr/app_text" />

                <RadioButton
                    android:id="@+id/radio_theme_light"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_theme_light"
                    android:textColor="?attr/app_text" />
            </RadioGroup>

            <!-- SECTION: SMALL WIDGET OPTIONS ONLY -->
            <LinearLayout
                android:id="@+id/section_small_widget_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/widget_action_click_title"
                    android:textColor="?attr/app_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/click_action_radio_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/radio_click_details"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_action_open_details"
                        android:textColor="?attr/app_text" />

                    <RadioButton
                        android:id="@+id/radio_click_toggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_action_toggle_lesson"
                        android:textColor="?attr/app_text" />

                    <RadioButton
                        android:id="@+id/radio_click_app"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_action_open_app"
                        android:textColor="?attr/app_text" />

                    <RadioButton
                        android:id="@+id/radio_click_excel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_action_open_excel"
                        android:textColor="?attr/app_text" />

                    <RadioButton
                        android:id="@+id/radio_click_refresh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_action_refresh"
                        android:textColor="?attr/app_text" />
                </RadioGroup>

                <TextView
                    android:id="@+id/break_action_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/widget_action_break_title"
                    android:textColor="?attr/app_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/break_action_radio_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/radio_break_app"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_action_open_app"
                        android:textColor="?attr/app_text" />

                    <RadioButton
                        android:id="@+id/radio_break_excel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_action_open_excel"
                        android:textColor="?attr/app_text" />
                </RadioGroup>
            </LinearLayout>

            <!-- SECTION: DAILY SCHEDULE WIDGET OPTIONS ONLY -->
            <LinearLayout
                android:id="@+id/section_daily_widget_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/widget_btn_visibility_title"
                    android:textColor="?attr/app_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_show_excel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/widget_show_excel_btn"
                    android:textColor="?attr/app_text" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_show_refresh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/widget_show_refresh_btn"
                    android:textColor="?attr/app_text" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_show_app"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/widget_show_app_btn"
                    android:textColor="?attr/app_text" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Save Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_save"
        style="@style/button"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_margin="16dp"
        android:text="@string/widget_save_settings"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
