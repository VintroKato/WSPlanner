<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:background="?attr/app_bg"
    tools:context=".ui.activities.WidgetConfigureActivity">

    <!-- Top App Bar -->
    <RelativeLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/button_back"
            style="@style/WSPlanner.HeaderIconButton"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/button_back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/title_label"
            style="@style/WSPlanner.TopBarTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginHorizontal="52dp"
            android:text="@string/widget_settings_title" />
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/configure_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:animateLayoutChanges="true"
        app:layout_constraintBottom_toTopOf="@+id/bottom_save_divider"
        app:layout_constraintTop_toBottomOf="@+id/top_bar">

        <LinearLayout
            android:id="@+id/configure_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- Capsule Dual Switcher -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/widget_type_capsule"
                style="@style/WSPlanner.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/tab_small_widget"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_capsule_tab_active"
                        android:clickable="true"
                        android:ellipsize="end"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:maxLines="1"
                        android:paddingHorizontal="8dp"
                        android:text="@string/widget_tab_small"
                        android:textColor="?attr/button_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tab_daily_widget"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:clickable="true"
                        android:ellipsize="end"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:maxLines="1"
                        android:paddingHorizontal="8dp"
                        android:text="@string/widget_tab_daily"
                        android:textColor="?attr/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Live Preview Title -->
            <TextView
                style="@style/WSPlanner.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_preview_title" />

            <!-- SMALL WIDGET PREVIEW (desktop widget visuals preserved untouched) -->
            <LinearLayout
                android:id="@+id/container_small_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:animateLayoutChanges="true"
                android:background="@drawable/bg_preview_wallpaper"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="16dp">

                <FrameLayout
                    android:id="@+id/preview_container"
                    android:layout_width="220dp"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:background="@drawable/bg_widget_dark"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="7dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/preview_status_chip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_pill"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="2dp"
                                android:text="@string/schedule_badge_now"
                                android:textColor="@color/badge_now_text"
                                android:textSize="9.5sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/preview_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/widget_preview_sample_time_1"
                                android:textColor="@color/widget_text_dark_primary"
                                android:textSize="10.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:id="@+id/preview_divider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="4dp"
                            android:background="#25FFFFFF" />

                        <TextView
                            android:id="@+id/preview_subject"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/widget_preview_sample_subject_1"
                            android:textColor="@color/widget_text_dark_primary"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:contentDescription="@string/widget_open_maps_tooltip"
                                android:src="@drawable/ic_location_pin" />

                            <TextView
                                android:id="@+id/preview_details"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/widget_preview_sample_room_1"
                                android:textColor="@color/widget_text_dark_secondary"
                                android:textSize="10.5sp" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- DAILY SCHEDULE WIDGET PREVIEW (desktop widget visuals preserved untouched) -->
            <LinearLayout
                android:id="@+id/container_daily_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:animateLayoutChanges="true"
                android:background="@drawable/bg_preview_wallpaper"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="12dp"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/preview_daily_root"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:background="@drawable/bg_widget_dark"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:layout_toStartOf="@+id/preview_daily_actions"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/preview_daily_title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/widget_preview_sample_date"
                                    android:textColor="@color/widget_text_dark_primary"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/preview_daily_subtitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/widget_text_dark_secondary"
                                    android:textSize="11sp"
                                    android:visibility="gone" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/preview_daily_actions"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/preview_btn_excel"
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:layout_marginEnd="4dp"
                                    android:background="@drawable/bg_widget_icon_btn"
                                    android:contentDescription="@string/widget_action_open_excel"
                                    android:padding="5dp"
                                    android:src="@drawable/ic_file_excel" />

                                <ImageView
                                    android:id="@+id/preview_btn_refresh"
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:layout_marginEnd="4dp"
                                    android:background="@drawable/bg_widget_icon_btn"
                                    android:contentDescription="@string/widget_action_refresh"
                                    android:padding="5dp"
                                    android:src="@drawable/ic_refresh" />

                                <ImageView
                                    android:id="@+id/preview_btn_app"
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:background="@drawable/bg_widget_icon_btn"
                                    android:contentDescription="@string/widget_action_open_app"
                                    android:padding="5dp"
                                    android:src="@drawable/ic_arrow_outward" />
                            </LinearLayout>
                        </RelativeLayout>

                        <LinearLayout
                            android:id="@+id/preview_daily_card_1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:background="@drawable/bg_widget_item_dark"
                            android:orientation="vertical"
                            android:paddingHorizontal="9dp"
                            android:paddingVertical="6dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/preview_card_1_time"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/widget_preview_sample_time_1"
                                    android:textColor="@color/widget_text_dark_primary"
                                    android:textSize="9.5sp"
                                    android:textStyle="bold" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="1dp"
                                    android:layout_weight="1" />

                                <TextView
                                    android:id="@+id/preview_card_1_type"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_badge_rect"
                                    android:paddingHorizontal="5dp"
                                    android:paddingVertical="1dp"
                                    android:text="@string/widget_preview_sample_type_lecture"
                                    android:textColor="@color/badge_now_text"
                                    android:textSize="8sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/preview_card_1_subject"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:text="@string/widget_preview_sample_subject_1"
                                android:textColor="@color/widget_text_dark_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/preview_card_1_room"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/widget_preview_sample_room_1"
                                android:textColor="@color/badge_field_text"
                                android:textSize="10.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/preview_daily_card_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_widget_item_dark"
                            android:orientation="vertical"
                            android:paddingHorizontal="9dp"
                            android:paddingVertical="6dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/preview_card_2_time"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/widget_preview_sample_time_2"
                                    android:textColor="@color/widget_text_dark_primary"
                                    android:textSize="9.5sp"
                                    android:textStyle="bold" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="1dp"
                                    android:layout_weight="1" />

                                <TextView
                                    android:id="@+id/preview_card_2_type"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_badge_rect"
                                    android:paddingHorizontal="5dp"
                                    android:paddingVertical="1dp"
                                    android:text="@string/widget_preview_sample_type_lab"
                                    android:textColor="@color/badge_now_text"
                                    android:textSize="8sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/preview_card_2_subject"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:text="@string/widget_preview_sample_subject_2"
                                android:textColor="@color/widget_text_dark_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/preview_card_2_room"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/widget_preview_sample_room_2"
                                android:textColor="@color/badge_field_text"
                                android:textSize="10.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- Tap to add to home screen hint -->
            <TextView
                android:id="@+id/preview_pin_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:drawablePadding="6dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:text="@string/widget_preview_tap_to_add"
                android:textColor="?attr/text_secondary"
                android:textSize="12.5sp" />

            <!-- Theme Selection: 2 selectable tiles -->
            <TextView
                style="@style/WSPlanner.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/widget_theme_title" />

            <LinearLayout
                android:id="@+id/widget_theme_tiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_widget_theme_dark"
                    style="@style/WSPlanner.SelectableCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minHeight="48dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:minHeight="48dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="10dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_dark_mode"
                            app:tint="?attr/app_text" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/widget_theme_dark"
                            android:textColor="?attr/app_text"
                            android:textSize="14sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_widget_theme_light"
                    style="@style/WSPlanner.SelectableCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:minHeight="48dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:minHeight="48dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="10dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_light_mode"
                            app:tint="?attr/app_text" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/widget_theme_light"
                            android:textColor="?attr/app_text"
                            android:textSize="14sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- SECTION: SMALL WIDGET OPTIONS -->
            <LinearLayout
                android:id="@+id/section_small_widget_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:orientation="vertical">

                <TextView
                    style="@style/WSPlanner.SectionHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/widget_action_click_title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/widget_action_click_subtitle"
                    android:textColor="?attr/text_secondary"
                    android:textSize="12.5sp" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/WSPlanner.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <RadioGroup
                        android:id="@+id/click_action_radio_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radio_click_details"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="44dp"
                            android:text="@string/widget_action_open_details"
                            android:textColor="?attr/app_text"
                            android:textSize="14sp" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radio_click_toggle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="44dp"
                            android:text="@string/widget_action_toggle_lesson"
                            android:textColor="?attr/app_text"
                            android:textSize="14sp" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radio_click_app"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="44dp"
                            android:text="@string/widget_action_open_app"
                            android:textColor="?attr/app_text"
                            android:textSize="14sp" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radio_click_excel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="44dp"
                            android:text="@string/widget_action_open_excel"
                            android:textColor="?attr/app_text"
                            android:textSize="14sp" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radio_click_refresh"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="44dp"
                            android:text="@string/widget_action_refresh"
                            android:textColor="?attr/app_text"
                            android:textSize="14sp" />
                    </RadioGroup>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/break_action_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/break_action_label"
                        style="@style/WSPlanner.SectionHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/widget_action_break_title" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/WSPlanner.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <RadioGroup
                            android:id="@+id/break_action_radio_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp">

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/radio_break_app"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="44dp"
                                android:text="@string/widget_action_open_app"
                                android:textColor="?attr/app_text"
                                android:textSize="14sp" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/radio_break_excel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="44dp"
                                android:text="@string/widget_action_open_excel"
                                android:textColor="?attr/app_text"
                                android:textSize="14sp" />
                        </RadioGroup>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>

            <!-- SECTION: DAILY SCHEDULE WIDGET OPTIONS -->
            <LinearLayout
                android:id="@+id/section_daily_widget_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/WSPlanner.SectionHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/widget_daily_action_click_title" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/WSPlanner.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <RadioGroup
                        android:id="@+id/daily_click_action_radio_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radio_daily_click_details"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="44dp"
                            android:text="@string/widget_daily_action_open_details"
                            android:textColor="?attr/app_text"
                            android:textSize="14sp" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radio_daily_click_app"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="44dp"
                            android:text="@string/widget_daily_action_open_app"
                            android:textColor="?attr/app_text"
                            android:textSize="14sp" />
                    </RadioGroup>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/WSPlanner.SectionHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/widget_btn_visibility_title" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/WSPlanner.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_show_excel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="50dp"
                            android:paddingHorizontal="14dp"
                            android:text="@string/widget_show_excel_btn"
                            android:textColor="?attr/app_text"
                            android:textSize="14sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="?attr/divider_color" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_show_refresh"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="50dp"
                            android:paddingHorizontal="14dp"
                            android:text="@string/widget_show_refresh_btn"
                            android:textColor="?attr/app_text"
                            android:textSize="14sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="?attr/divider_color" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_show_app"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="50dp"
                            android:paddingHorizontal="14dp"
                            android:text="@string/widget_show_app_btn"
                            android:textColor="?attr/app_text"
                            android:textSize="14sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:id="@+id/bottom_save_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/divider_color"
        app:layout_constraintBottom_toTopOf="@+id/button_save" />

    <!-- Wide Save Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_save"
        style="@style/WSPlanner.PrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="12dp"
        android:text="@string/widget_save_settings"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
