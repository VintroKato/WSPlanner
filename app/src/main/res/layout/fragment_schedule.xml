<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/schedule_fragment_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/app_bg">

    <LinearLayout
        android:id="@+id/main_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Symmetric 56dp header: Excel - Month Picker Button - WSPA PUW -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <FrameLayout
                android:id="@+id/button_open_file"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:clickable="true"
                android:contentDescription="@string/widget_action_open_excel"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_icon_btn"
                    android:duplicateParentState="true">

                    <ImageView
                        android:id="@+id/icon_open_file"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_file_excel" />

                    <ProgressBar
                        android:id="@+id/progress_open_file"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        android:indeterminateTint="?attr/colorPrimary"
                        android:visibility="gone" />
                </FrameLayout>
            </FrameLayout>

            <!-- Clickable Month Picker Button -->
            <LinearLayout
                android:id="@+id/button_calendar_picker"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_centerInParent="true"
                android:layout_marginHorizontal="56dp"
                android:background="@drawable/bg_month_picker_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_calendar"
                    app:tint="?attr/text_secondary" />

                <TextView
                    android:id="@+id/month_header_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/main_title"
                    android:textColor="?attr/app_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="2dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_expand_more"
                    app:tint="?attr/text_muted" />
            </LinearLayout>

            <!-- WSPA PUW Autologin Button with overlapping external-link mini-badge -->
            <FrameLayout
                android:id="@+id/button_open_puw"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:clickable="true"
                android:clipChildren="false"
                android:contentDescription="@string/schedule_open_puw_desc"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_icon_btn"
                    android:duplicateParentState="true">

                    <ImageView
                        android:id="@+id/icon_open_puw"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_wspa_logo" />

                    <ProgressBar
                        android:id="@+id/progress_open_puw"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        android:indeterminateTint="?attr/colorPrimary"
                        android:visibility="gone" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="1dp"
                    android:layout_marginBottom="1dp"
                    android:background="@drawable/bg_external_link_badge">

                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_outward"
                        app:tint="?attr/text_secondary" />
                </FrameLayout>
            </FrameLayout>
        </RelativeLayout>

        <!-- Weekly ViewPager2 strip aligned to 16dp grid with translucent peek of adjacent weeks -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/week_strip_pager"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:overScrollMode="never" />

        <!-- Lightweight inline sync status row with bounded rounded ripple -->
        <LinearLayout
            android:id="@+id/pill_sync_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_sync_status_ripple"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/icon_sync_refresh"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_refresh"
                app:tint="?attr/text_muted" />

            <TextView
                android:id="@+id/last_sync_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text=""
                android:textColor="?attr/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- SwipeRefreshLayout + ViewPager2 -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/schedule_view_pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <!-- Floating Back to Today pill with high elevation shadow above lesson cards -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/fab_back_to_today"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:clickable="true"
        android:focusable="true"
        android:outlineAmbientShadowColor="#CC000000"
        android:outlineSpotShadowColor="#FF000000"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/button_bg"
        app:cardCornerRadius="24dp"
        app:cardElevation="10dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/icon_back_to_today"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_arrow_back"
                app:tint="?attr/button_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/schedule_back_to_today"
                android:textColor="?attr/button_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
