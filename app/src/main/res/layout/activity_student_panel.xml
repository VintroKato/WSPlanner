<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/app_bg"
    android:fillViewport="true"
    tools:context=".ui.activities.StudentPanelActivity">

    <LinearLayout
        android:id="@+id/root_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="16dp">

            <ImageButton
                android:id="@+id/back_button"
                style="@style/WSPlanner.HeaderIconButton"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/button_back"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:id="@+id/title_label"
                style="@style/WSPlanner.TopBarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_marginHorizontal="52dp"
                android:text="@string/student_panel_title" />
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/content_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <!-- Study Information Section Header -->
            <TextView
                android:id="@+id/course_section_header"
                style="@style/WSPlanner.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/student_panel_course_section" />

            <!-- Study Information Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_course_info"
                style="@style/WSPlanner.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_major_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.04"
                        android:text="@string/onboarding_major_label"
                        android:textAllCaps="true"
                        android:textColor="?attr/text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_major_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="?attr/app_text"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="Informatyka" />

                    <View
                        android:id="@+id/course_details_divider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="?attr/divider_color" />

                    <LinearLayout
                        android:id="@+id/layout_course_metrics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingEnd="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/onboarding_level_label"
                                android:textColor="?attr/text_muted"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_level_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="?attr/app_text"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="I stopień" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingEnd="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/onboarding_mode_label"
                                android:textColor="?attr/text_muted"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_mode_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="?attr/app_text"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="Stacjonarne" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="48dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/onboarding_year_label"
                                android:textColor="?attr/text_muted"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_year_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="?attr/app_text"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="2" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_specialty_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="12dp"
                            android:background="?attr/divider_color" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/student_panel_specialty_label"
                            android:textColor="?attr/text_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_specialty_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="?attr/app_text"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="Programowanie" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Compact secondary action buttons -->
            <LinearLayout
                android:id="@+id/layout_onboarding_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_re_onboarding"
                    style="@style/WSPlanner.SecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:minHeight="44dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/student_panel_btn_re_onboarding"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_school"
                    app:iconGravity="textStart"
                    app:iconSize="17dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_change_credentials"
                    style="@style/WSPlanner.SecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:minHeight="44dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/student_panel_btn_change_login"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_key"
                    app:iconGravity="textStart"
                    app:iconSize="17dp" />
            </LinearLayout>

            <!-- Personal Parameters Header -->
            <TextView
                android:id="@+id/personal_section_header"
                style="@style/WSPlanner.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:text="@string/student_panel_personal_section" />

            <LinearLayout
                android:id="@+id/searching_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/searching_progress"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:indeterminate="true"
                    android:indeterminateTint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/searching_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/onboarding_searching_additional_data"
                    android:textColor="?attr/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Grouped Personal Parameters Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_personal_params"
                style="@style/WSPlanner.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:orientation="vertical">

                    <!-- Student Surname -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/surname_title_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/onboarding_surname_title"
                            android:textColor="?attr/app_text"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/surname_subtitle_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/onboarding_surname_subtitle"
                            android:textColor="?attr/text_secondary"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/student_surname_input"
                            style="@style/WSPlanner.CardInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:hint="@string/onboarding_surname_hint"
                            android:inputType="textCapWords"
                            android:tag="card_input"
                            android:textAlignment="textStart" />
                    </LinearLayout>

                    <View
                        android:id="@+id/divider_english"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/divider_color" />

                    <!-- English Group Switch & Input -->
                    <LinearLayout
                        android:id="@+id/english_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:animateLayoutChanges="true"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/english_switch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/onboarding_english_switch"
                            android:textColor="?attr/app_text"
                            android:textSize="15sp" />

                        <EditText
                            android:id="@+id/english_input"
                            style="@style/WSPlanner.CardInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:hint="@string/onboarding_english_hint"
                            android:inputType="number"
                            android:tag="card_input"
                            android:textAlignment="textStart"
                            android:visibility="gone" />
                    </LinearLayout>

                    <View
                        android:id="@+id/divider_seminar"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/divider_color" />

                    <!-- Diploma Seminar Switch & Input -->
                    <LinearLayout
                        android:id="@+id/seminar_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:animateLayoutChanges="true"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/seminar_switch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/onboarding_seminar_switch"
                            android:textColor="?attr/app_text"
                            android:textSize="15sp" />

                        <EditText
                            android:id="@+id/seminar_input"
                            style="@style/WSPlanner.CardInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:hint="@string/onboarding_seminar_hint"
                            android:inputType="textPersonName"
                            android:tag="card_input"
                            android:textAlignment="textStart"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Wide Save CTA Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirm_button"
                style="@style/WSPlanner.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                android:text="@string/student_panel_save_button" />

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
