<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Version Header: Badge + Commit/Release Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/version_tag_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_rect"
            android:backgroundTint="?attr/update_badge_new_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="v1.1.0"
            android:textColor="?attr/update_badge_new_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/version_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Release title or commit message"
            android:textColor="?attr/app_text"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Version Bullet Items Container -->
    <LinearLayout
        android:id="@+id/version_items_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />

    <!-- Legacy / Note text if version has no itemized changelog -->
    <TextView
        android:id="@+id/version_legacy_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="4dp"
        android:alpha="0.8"
        android:textColor="?attr/app_text"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Divider between versions -->
    <View
        android:id="@+id/version_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="?attr/card_border" />
</LinearLayout>
