<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/onboarding_steps"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingTop="4dp"
    android:paddingBottom="12dp">

    <View
        android:id="@+id/onboarding_step_1"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:background="@drawable/bg_onboarding_step"
        android:backgroundTint="?attr/divider_color" />

    <View
        android:id="@+id/onboarding_step_2"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:background="@drawable/bg_onboarding_step"
        android:backgroundTint="?attr/divider_color" />

    <View
        android:id="@+id/onboarding_step_3"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:background="@drawable/bg_onboarding_step"
        android:backgroundTint="?attr/divider_color" />

    <View
        android:id="@+id/onboarding_step_4"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_weight="1"
        android:background="@drawable/bg_onboarding_step"
        android:backgroundTint="?attr/divider_color" />
</LinearLayout>
