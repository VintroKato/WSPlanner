<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_daily_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_dark"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: Date, Count & Quick Action buttons -->
    <RelativeLayout
        android:id="@+id/widget_daily_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/widget_daily_actions"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_daily_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/widget_text_dark_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_daily_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:textColor="@color/widget_text_dark_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Right Quick Actions -->
        <LinearLayout
            android:id="@+id/widget_daily_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_daily_btn_excel"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_widget_icon_btn"
                android:contentDescription="@string/widget_action_open_excel"
                android:padding="5dp"
                android:src="@drawable/ic_file_excel" />

            <FrameLayout
                android:id="@+id/widget_daily_btn_refresh"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_widget_icon_btn"
                android:contentDescription="@string/widget_action_refresh">

                <ImageView
                    android:id="@+id/widget_daily_refresh_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="5dp"
                    android:src="@drawable/ic_refresh"
                    android:contentDescription="@null" />

                <ProgressBar
                    android:id="@+id/widget_daily_refresh_progress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:indeterminateTint="#FFFFFF"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/widget_daily_refresh_check"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="5dp"
                    android:src="@drawable/ic_widget_check"
                    android:visibility="gone"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/widget_daily_refresh_error"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="5dp"
                    android:src="@drawable/ic_widget_error"
                    android:visibility="gone"
                    android:contentDescription="@null" />
            </FrameLayout>

            <ImageView
                android:id="@+id/widget_daily_btn_app"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_widget_icon_btn"
                android:contentDescription="@string/widget_action_open_app"
                android:padding="5dp"
                android:src="@drawable/ic_arrow_outward" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Scrollable Lessons List -->
    <ListView
        android:id="@+id/widget_daily_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="6dp" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/widget_daily_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_daily_empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_no_classes_today"
            android:textColor="@color/widget_text_dark_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_daily_empty_subtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/widget_text_dark_secondary"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
