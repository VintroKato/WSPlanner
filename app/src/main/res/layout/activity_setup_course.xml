<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:paddingBottom="80dp">

        <TextView
            android:id="@+id/title_label"
            style="@style/label"
            android:layout_marginTop="20dp"
            android:text="@string/onboarding_course_title"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/loading_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="48dp"
            android:paddingHorizontal="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title_label">

            <ProgressBar
                android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="?attr/app_text"
                android:indeterminateTintMode="src_atop"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/loading_label"
                style="@style/label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/onboarding_loading_courses"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/content_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:animateLayoutChanges="true"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/title_label"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/major_label"
                style="@style/label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:text="@string/onboarding_major_label" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/major_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="4dp"
                android:checkable="true"
                app:checkedIcon="@null"
                app:cardElevation="0dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/settings_card_border"
                app:cardBackgroundColor="@color/settings_card_checked_bg"
                app:cardCornerRadius="16dp">

                <TextView
                    android:id="@+id/major_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingVertical="14dp"
                    android:paddingHorizontal="16dp"
                    android:text="Informatyka"
                    android:textColor="?attr/app_text"
                    android:textSize="16sp" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/level_label"
                style="@style/label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:text="@string/onboarding_level_label" />

            <GridLayout
                android:id="@+id/level_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:paddingHorizontal="8dp" />

            <TextView
                android:id="@+id/mode_label"
                style="@style/label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:visibility="gone"
                android:text="@string/onboarding_mode_label" />

            <GridLayout
                android:id="@+id/mode_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:visibility="gone"
                android:paddingHorizontal="8dp" />

            <TextView
                android:id="@+id/year_label"
                style="@style/label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:visibility="gone"
                android:text="@string/onboarding_year_label" />

            <GridLayout
                android:id="@+id/year_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:visibility="gone"
                android:paddingHorizontal="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirm_button"
                style="@style/button"
                android:layout_width="183dp"
                android:layout_height="57dp"
                android:layout_marginTop="32dp"
                android:layout_gravity="center_horizontal"
                android:text="@string/onboarding_button_next" />

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
