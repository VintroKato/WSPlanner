<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/app_bg"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/root_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="16dp">

            <ImageButton
                android:id="@+id/back_button"
                style="@style/WSPlanner.HeaderIconButton"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/button_back"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:id="@+id/title_label"
                style="@style/WSPlanner.TopBarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_marginHorizontal="52dp"
                android:text="@string/onboarding_additional_title" />
        </RelativeLayout>

        <!-- 4-step progress indicator -->
        <include layout="@layout/layout_onboarding_steps" />

        <LinearLayout
            android:id="@+id/content_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <LinearLayout
                android:id="@+id/searching_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/searching_progress"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:indeterminate="true"
                    android:indeterminateTint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/searching_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/onboarding_searching_additional_data"
                    android:textColor="?attr/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Grouped Additional Options Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/WSPlanner.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:orientation="vertical">

                    <!-- Student Surname -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/surname_title_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/onboarding_surname_title"
                            android:textColor="?attr/app_text"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/surname_subtitle_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/onboarding_surname_subtitle"
                            android:textColor="?attr/text_secondary"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/student_surname_input"
                            style="@style/WSPlanner.CardInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:hint="@string/onboarding_surname_hint"
                            android:inputType="textCapWords"
                            android:tag="card_input"
                            android:textAlignment="textStart" />
                    </LinearLayout>

                    <View
                        android:id="@+id/divider_english"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/divider_color" />

                    <!-- English Group -->
                    <LinearLayout
                        android:id="@+id/english_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:animateLayoutChanges="true"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/english_switch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/onboarding_english_switch"
                            android:textColor="?attr/app_text"
                            android:textSize="15sp" />

                        <EditText
                            android:id="@+id/english_input"
                            style="@style/WSPlanner.CardInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:hint="@string/onboarding_english_hint"
                            android:inputType="number"
                            android:tag="card_input"
                            android:textAlignment="textStart"
                            android:visibility="gone" />
                    </LinearLayout>

                    <View
                        android:id="@+id/divider_seminar"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/divider_color" />

                    <!-- Diploma Seminar -->
                    <LinearLayout
                        android:id="@+id/seminar_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:animateLayoutChanges="true"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/seminar_switch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/onboarding_seminar_switch"
                            android:textColor="?attr/app_text"
                            android:textSize="15sp" />

                        <EditText
                            android:id="@+id/seminar_input"
                            style="@style/WSPlanner.CardInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:hint="@string/onboarding_seminar_hint"
                            android:inputType="textPersonName"
                            android:tag="card_input"
                            android:textAlignment="textStart"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Wide Finish CTA Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirm_button"
                style="@style/WSPlanner.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                android:text="@string/onboarding_button_finish" />

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
