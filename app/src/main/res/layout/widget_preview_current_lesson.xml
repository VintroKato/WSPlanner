<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Card wrapped in centered container so it never stretches vertically in preview dialogs -->
    <LinearLayout
        android:id="@+id/widget_preview_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_widget_dark"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="11dp"
        android:paddingBottom="11dp">

        <!-- Top Bar: Status Chip (Left) + Time (Right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Status Chip (e.g. NOW) -->
            <LinearLayout
                android:id="@+id/widget_preview_chip"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:background="@drawable/bg_badge_pill"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp">

                <TextView
                    android:id="@+id/widget_preview_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/schedule_badge_now"
                    android:textColor="@color/badge_now_text"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Flexible Spacer to push time to the right -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Lesson Time (Right) -->
            <TextView
                android:id="@+id/widget_preview_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:ellipsize="none"
                android:maxLines="1"
                android:text="@string/widget_preview_sample_time_1"
                android:textColor="@color/widget_text_dark_primary"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Subtle Divider -->
        <LinearLayout
            android:id="@+id/widget_preview_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="#25FFFFFF"
            android:orientation="horizontal" />

        <!-- Main Lesson Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <!-- Subject Name -->
            <TextView
                android:id="@+id/widget_preview_subject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/widget_preview_sample_subject_1"
                android:textColor="@color/widget_text_dark_primary"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <!-- Location Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_preview_location_icon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="@string/widget_open_maps_tooltip"
                    android:src="@drawable/ic_location_pin" />

                <TextView
                    android:id="@+id/widget_preview_room"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_preview_sample_room_1"
                    android:textColor="@color/widget_text_dark_secondary"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
