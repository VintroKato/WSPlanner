<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_popup_menu"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header: Icon, Title, and Close -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/dialog_update_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="@null"
                android:src="@drawable/ic_update_alert" />

            <TextView
                android:id="@+id/dialog_update_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_toEndOf="@+id/dialog_update_icon"
                android:layout_toStartOf="@+id/dialog_update_close"
                android:text="@string/update_dialog_title"
                android:textColor="?attr/app_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/dialog_update_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close"
                android:src="@drawable/ic_close"
                app:tint="?attr/app_text" />
        </RelativeLayout>

        <!-- Version Comparison Badges -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dialog_current_version_badge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_badge_rect"
                android:backgroundTint="?attr/card_bg"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:paddingHorizontal="10dp"
                android:text="0.5.1"
                android:textColor="?attr/app_text"
                android:textSize="13sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginHorizontal="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                app:tint="?attr/app_text" />

            <TextView
                android:id="@+id/dialog_new_version_badge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_badge_rect"
                android:backgroundTint="?attr/update_badge_new_bg"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:paddingHorizontal="10dp"
                android:text="v0.5.2"
                android:textColor="?attr/update_badge_new_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Description Note / Changelog -->
        <TextView
            android:id="@+id/dialog_update_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:alpha="0.85"
            android:fadeScrollbars="false"
            android:lineSpacingExtra="3dp"
            android:scrollbars="vertical"
            android:text="@string/update_dialog_desc"
            android:textColor="?attr/app_text"
            android:textSize="14sp" />

        <!-- Error / Failure Banner (Shown if automatic download or launch fails) -->
        <LinearLayout
            android:id="@+id/dialog_update_error_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_badge_rect"
            android:backgroundTint="#24FF5252"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_update_alert"
                app:tint="#FF5252" />

            <TextView
                android:id="@+id/dialog_update_error_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:lineSpacingExtra="2dp"
                android:text="@string/update_dialog_error_desc"
                android:textColor="?attr/app_text"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Buttons Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical">

            <!-- Primary Action: Auto Update -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dialog_btn_auto_update"
                    style="@style/button"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="@string/update_dialog_button_auto"
                    android:textSize="15sp"
                    app:icon="@drawable/ic_update_check"
                    app:iconGravity="textStart"
                    app:iconSize="18dp"
                    app:iconTint="?attr/button_text" />

                <ProgressBar
                    android:id="@+id/dialog_auto_update_progress"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="16dp"
                    android:indeterminate="true"
                    android:indeterminateTint="?attr/button_text"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Secondary Action: Open GitHub Release Page -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialog_btn_open_github"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/update_dialog_button_github"
                android:textColor="?attr/app_text"
                android:textSize="14sp"
                app:icon="@drawable/ic_arrow_outward"
                app:iconGravity="textEnd"
                app:iconSize="18dp"
                app:iconTint="?attr/app_text" />

            <!-- Tertiary Action: Later -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialog_btn_later"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:text="@string/update_dialog_button_later"
                android:textColor="?attr/app_text"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
