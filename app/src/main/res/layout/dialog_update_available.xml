<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_surface"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header: Icon, Title, and Close -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/dialog_update_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="@null"
                android:src="@drawable/ic_update_alert" />

            <TextView
                android:id="@+id/dialog_update_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_toStartOf="@+id/dialog_update_close"
                android:layout_toEndOf="@+id/dialog_update_icon"
                android:text="@string/update_dialog_title"
                android:textColor="?attr/app_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/dialog_update_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/common_close"
                android:src="@drawable/ic_close"
                app:tint="?attr/text_secondary" />
        </RelativeLayout>

        <!-- Version Comparison Badges -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dialog_current_version_badge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_recessed_chip"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:text="0.5.1"
                android:textColor="?attr/text_secondary"
                android:textSize="13sp" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginHorizontal="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                app:tint="?attr/text_muted" />

            <TextView
                android:id="@+id/dialog_new_version_badge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_update_version_pill"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:text="v0.5.2"
                android:textColor="?attr/update_badge_new_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Changelog Section Header -->
        <LinearLayout
            android:id="@+id/dialog_changelog_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_edit_note"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/dialog_changelog_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/update_dialog_changelog_subtitle"
                android:textColor="?attr/app_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Changelog Scrollable Container -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/dialog_changelog_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_recessed_input"
            android:fadeScrollbars="false"
            android:overScrollMode="ifContentScrolls"
            android:padding="12dp"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/dialog_changelog_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dialog_update_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/update_dialog_desc"
                    android:textColor="?attr/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Error / Failure Banner -->
        <LinearLayout
            android:id="@+id/dialog_update_error_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_error_banner"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_update_alert"
                app:tint="?attr/input_border_error" />

            <TextView
                android:id="@+id/dialog_update_error_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:lineSpacingExtra="2dp"
                android:text="@string/update_dialog_error_desc"
                android:textColor="?attr/app_text"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Buttons Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical">

            <!-- Primary Action: Auto Update -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dialog_btn_auto_update"
                    style="@style/WSPlanner.PrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:minHeight="50dp"
                    android:text="@string/update_dialog_button_auto"
                    android:textSize="15sp"
                    app:icon="@drawable/ic_update_check"
                    app:iconGravity="textStart"
                    app:iconSize="18dp"
                    app:iconTint="?attr/button_text" />

                <ProgressBar
                    android:id="@+id/dialog_auto_update_progress"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="16dp"
                    android:indeterminate="true"
                    android:indeterminateTint="?attr/button_text"
                    android:visibility="gone" />
            </FrameLayout>

            <ProgressBar
                android:id="@+id/dialog_auto_update_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progress="0"
                android:progressTint="?attr/colorPrimary"
                android:indeterminateTint="?attr/colorPrimary"
                android:visibility="gone" />

            <!-- Secondary Action: Open GitHub Release Page -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialog_btn_open_github"
                style="@style/WSPlanner.SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:text="@string/update_dialog_button_github"
                android:textSize="14sp"
                app:icon="@drawable/ic_arrow_outward"
                app:iconGravity="textEnd"
                app:iconSize="17dp" />

            <!-- Tertiary Action: Later -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialog_btn_later"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/update_dialog_button_later"
                android:textColor="?attr/text_secondary"
                android:textSize="14sp"
                app:cornerRadius="14dp" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
