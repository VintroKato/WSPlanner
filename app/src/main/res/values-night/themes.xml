<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.WSPlanner" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:autofilledHighlight">@drawable/shape_input_autofilled</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Base surfaces and typography -->
        <item name="app_bg">@color/bg_dark</item>
        <item name="app_text">@color/text_dark</item>
        <item name="text_secondary">@color/text_secondary_dark</item>
        <item name="text_muted">@color/text_muted_dark</item>
        <item name="card_bg">@color/card_bg_dark</item>
        <item name="card_border">@color/card_border_dark</item>
        <item name="card_checked_bg">@color/card_checked_bg_dark</item>
        <item name="card_checked_border">@color/card_checked_border_dark</item>
        <item name="surface_recessed">@color/surface_recessed_dark</item>
        <item name="divider_color">@color/divider_dark</item>
        <item name="dialog_bg">@color/dialog_bg_dark</item>
        <item name="dialog_border">@color/dialog_border_dark</item>
        <item name="bottom_nav_bg">@color/bottom_nav_bg_dark</item>
        <item name="bottom_nav_indicator">@color/bottom_nav_indicator_dark</item>

        <!-- Inputs and buttons -->
        <item name="input_bg">@color/input_bg_dark</item>
        <item name="input_bg_active">@color/input_bg_active_dark</item>
        <item name="input_bg_autofilled">@color/input_bg_autofilled</item>
        <item name="input_border">@color/input_border_dark</item>
        <item name="input_border_active">@color/input_border_active_dark</item>
        <item name="input_hint">@color/input_hint_dark</item>
        <item name="input_border_ok">@color/input_border_ok_dark</item>
        <item name="input_border_error">@color/input_border_error_dark</item>
        <item name="button_bg">@color/btn_bg</item>
        <item name="button_text">@color/btn_text_dark</item>

        <!-- Lesson stripes and status banners -->
        <item name="stripe_active">@color/stripe_active_dark</item>
        <item name="stripe_past">@color/stripe_past_dark</item>
        <item name="card_now_bg">@color/card_now_bg_dark</item>
        <item name="email_link_text">@color/email_link_dark</item>
        <item name="wspa_logo_grey">@color/wspa_logo_grey_dark</item>
        <item name="wspa_logo_red">@color/wspa_logo_red_dark</item>
        <item name="card_shadow_color">@color/card_shadow_dark</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="banner_now_bg">@color/banner_now_bg_dark</item>
        <item name="banner_next_bg">@color/banner_next_bg_dark</item>
        <item name="progress_track_now">@color/progress_track_now_dark</item>
        <item name="active_lesson_border">@color/active_lesson_border_dark</item>
        <item name="next_lesson_border">@color/next_lesson_border_dark</item>

        <!-- Adaptive badges -->
        <item name="badge_wspa_bg">@color/badge_wspa_bg_dark</item>
        <item name="badge_wspa_border">@color/badge_wspa_border_dark</item>
        <item name="badge_wspa_text">@color/badge_wspa_text_dark</item>
        <item name="badge_puw_bg">@color/badge_puw_bg_dark</item>
        <item name="badge_puw_border">@color/badge_puw_border_dark</item>
        <item name="badge_puw_text">@color/badge_puw_text_dark</item>
        <item name="badge_field_bg">@color/badge_field_bg_dark</item>
        <item name="badge_field_border">@color/badge_field_border_dark</item>
        <item name="badge_field_text">@color/badge_field_text_dark</item>
        <item name="badge_now_bg">@color/badge_now_bg_dark</item>
        <item name="badge_now_border">@color/badge_now_border_dark</item>
        <item name="badge_now_text">@color/badge_now_text_dark</item>
        <item name="badge_next_bg">@color/badge_next_bg_dark</item>
        <item name="badge_next_border">@color/badge_next_border_dark</item>
        <item name="badge_next_text">@color/badge_next_text_dark</item>
        <item name="badge_type_bg">@color/badge_type_bg_dark</item>
        <item name="badge_type_border">@color/badge_type_border_dark</item>
        <item name="badge_type_text">@color/badge_type_text_dark</item>
        <item name="update_alert_tint">@color/update_alert_tint_dark</item>

        <!-- Material 3 color tokens -->
        <item name="colorPrimary">@color/color_primary_dark</item>
        <item name="colorOnPrimary">@color/btn_text_dark</item>
        <item name="colorPrimaryContainer">@color/card_checked_bg_dark</item>
        <item name="colorOnPrimaryContainer">@color/color_primary_dark</item>
        <item name="colorSecondary">@color/color_primary_dark</item>
        <item name="colorOnSecondary">@color/btn_text_dark</item>
        <item name="colorSecondaryContainer">@color/bottom_nav_indicator_dark</item>
        <item name="colorOnSecondaryContainer">@color/color_primary_dark</item>
        <item name="colorSurface">@color/card_bg_dark</item>
        <item name="colorSurfaceVariant">@color/surface_recessed_dark</item>
        <item name="colorSurfaceContainerLowest">@color/bg_dark</item>
        <item name="colorSurfaceContainerLow">@color/bg_dark</item>
        <item name="colorSurfaceContainer">@color/bottom_nav_bg_dark</item>
        <item name="colorSurfaceContainerHigh">@color/card_bg_dark</item>
        <item name="colorSurfaceContainerHighest">@color/card_checked_bg_dark</item>
        <item name="colorOnSurface">@color/text_dark</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_dark</item>
        <item name="colorOutline">@color/card_border_dark</item>
        <item name="colorOutlineVariant">@color/divider_dark</item>
        <item name="colorControlActivated">@color/color_primary_dark</item>
        <item name="colorControlHighlight">@color/bottom_nav_indicator_dark</item>

        <!-- Switches and update badge -->
        <item name="switch_thumb_tint">@color/switch_thumb_dark</item>
        <item name="switch_track_tint">@color/switch_track_dark</item>
        <item name="update_badge_new_bg">@color/update_badge_new_bg_dark</item>
        <item name="update_badge_new_text">@color/update_badge_new_text_dark</item>

        <item name="materialSwitchStyle">@style/CustomSwitchStyle</item>

        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <style name="ThemeOverlay.WSPlanner.DatePicker" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="colorPrimary">@color/color_primary_dark</item>
        <item name="colorOnPrimary">@color/btn_text_dark</item>
        <item name="colorSurface">@color/dialog_bg_dark</item>
        <item name="colorSurfaceContainerHigh">@color/dialog_bg_dark</item>
        <item name="colorOnSurface">@color/text_dark</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_dark</item>
        <item name="colorOutline">@color/dialog_border_dark</item>
        <item name="colorOutlineVariant">@color/divider_dark</item>
    </style>
</resources>
