<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#405E76AF" />
            <stroke android:width="1dp" android:color="#505E76AF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#245E76AF" />
            <stroke android:width="1dp" android:color="#355E76AF" />
        </shape>
    </item>
</selector>
